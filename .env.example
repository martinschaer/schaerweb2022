# SurrealDB connection for the public leaderboard (Surreal Cloud).
#
# These are PUBLIC_ on purpose: Astro inlines them into the client bundle, and
# the browser connects to SurrealDB directly. They are not secrets — no
# credentials are shipped. The browser signs in through the `player` record
# access defined in db/schema.surql, which can list scores and append new ones
# and nothing else.
#
# Leave them unset to build the site with the leaderboard hidden.
PUBLIC_SURREAL_URL=wss://your-instance.surreal.cloud/rpc
PUBLIC_SURREAL_NS=schaerweb
PUBLIC_SURREAL_DB=arcade
PUBLIC_SURREAL_ACCESS=player
